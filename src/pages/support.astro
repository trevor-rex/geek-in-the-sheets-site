---
import Base from "../layouts/Base.astro";
---

<Base
  title="Support | Geek in the Sheets"
  description="Get help with Geek in the Sheets, the AI assistant for Google Sheets. Contact support at support@geekinthesheets.app."
  canonical="https://www.geekinthesheets.app/support/"
>
  <Fragment slot="head">
    <style is:global>
      body {
        font-family: Arial, sans-serif;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        margin: 0;
        background-color: #f9f9f9;
        color: #1a1a1a;
      }
      main {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 2rem;
        max-width: 480px;
        margin: 0 auto;
      }
      h1 {
        font-size: 1.5rem;
        color: #2e7d32;
        margin-bottom: 1rem;
      }
      p {
        font-size: 1rem;
        color: #444;
        line-height: 1.6;
      }
      a {
        color: #2e7d32;
      }
    </style>
  </Fragment>

  <main>
    <h1>Support</h1>
    <p>
      For support, please reach out to
      <a href="mailto:support@geekinthesheets.app">support@geekinthesheets.app</a
      >.
    </p>
  </main>
</Base>
